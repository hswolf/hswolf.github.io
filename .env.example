# Copy this file to .env and fill in whichever token you want to use.
# .env is git-ignored — nothing in here leaves your machine.
#
# Pollinations (default) requires no key at all: just run `npm run gen:images`.
# Fill in HF_TOKEN only if you also want the Hugging Face provider available.
#
# Get a free Hugging Face token at: https://huggingface.co/settings/tokens
# (any role works; "read" is enough)
HF_TOKEN=

# Optional overrides for the flashcard image generator:
# PROVIDER=pollinations          # "pollinations" (default, no key) or "hf"
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# POLLINATIONS_MODEL=flux        # see https://image.pollinations.ai/models
# GEN_DELAY_MS=4000              # ms between requests
